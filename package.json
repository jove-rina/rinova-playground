{
  "name": "rinova-playground-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build:plugin": "pnpm --filter @rinova/playground-vite build",
    "dev": "pnpm build:plugin && pnpm --filter @rinova/example-minimal-lib dev",
    "build": "pnpm build:plugin && pnpm --filter @rinova/example-minimal-lib build",
    "preview": "pnpm --filter @rinova/example-minimal-lib preview",
    "typecheck": "pnpm -r typecheck",
    "verify": "node --experimental-strip-types scripts/verify-m0.ts",
    "build:create": "pnpm --filter create-rinova-playground build",
    "build:all": "pnpm -r --filter './packages/*' build",
    "dev:docs": "pnpm --filter @rinova/example-docs dev",
    "build:docs": "pnpm --filter @rinova/example-docs build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vue-component-meta": "3.3.14"
  }
}
