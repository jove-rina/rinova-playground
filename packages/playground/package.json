{
  "name": "@rinova/playground",
  "version": "0.1.3",
  "description": "\u9762\u5411 Vue3 \u7684\u300c\u6587\u4ef6\u5373\u573a\u666f\u300d\u7ec4\u4ef6\u6f14\u793a\u6846\u67b6",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/monaco": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "monaco-editor": "0.57.0",
    "shiki": "4.6.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build && vue-tsc -p tsconfig.types.json && node --experimental-strip-types scripts/finalize-types.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "less": "4.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jove-rina/rinova-playground"
  }
}
