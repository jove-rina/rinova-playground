{
  "name": "@rinova/playground",
  "version": "0.8.2",
  "description": "面向 Vue3 的「文件即场景」组件演示框架",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "marked": "18.1.3",
    "shiki": "4.6.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build && vue-tsc -p tsconfig.types.json && node --experimental-strip-types scripts/finalize-types.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "less": "4.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jove-rina/rinova-playground"
  }
}
